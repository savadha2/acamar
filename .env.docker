# Overrides for running under `docker compose` — layered on top of the
# existing .env (docker-compose.yml loads .env first, then this file, so
# only values that genuinely differ inside the compose network need to be
# here; everything else — model names, scraper settings, tokens — still
# comes from .env unchanged). See
# docs/gcp-aws-deployment-proposal.md §14 for why these three specifically
# can't be reused as-is from bare-metal .env.

# Postgres: the compose service name `postgres`, not localhost — containers
# don't share the host's network namespace.
DATABASE_URL=postgresql://acamar:acamar@postgres:5432/acamar

# Ollama deliberately stays OUTSIDE docker compose (§14 — Docker Desktop on
# Mac can't pass Metal GPU through to a container), so containers reach it
# via Docker's special host-gateway DNS name instead of localhost.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# What the dashboard/cockpit containers call to reach the API — the
# compose service name, not localhost (same reasoning as DATABASE_URL).
API_BASE_URL=http://api:8000
