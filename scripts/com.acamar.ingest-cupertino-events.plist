<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Cupertino Parks & Rec events, once a day, from this Mac, into both
         local Postgres and GCP Cloud SQL (2026-10-25 — cupertino.gov's
         Akamai WAF blocks Google Cloud, see CLAUDE.md). Fires every 4 hours
         (03/07/11/15/19/23:00 — aligned so one firing is the 07:00 daily
         slot), plus at load/login; launchd also fires a missed check right
         after wake. The script only does real work when a target hasn't
         succeeded since the most recent 07:00 — see
         run_cupertino_events_ingestion.sh — so this is a daily run with
         catch-up after sleep or shutdown, and a failed attempt is retried
         at the next 4-hourly check. -->
    <key>Label</key>
    <string>com.acamar.ingest-cupertino-events</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/kavitha/Projects/acamar/scripts/run_cupertino_events_ingestion.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/kavitha/Projects/acamar</string>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>23</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/kavitha/Projects/acamar/logs/ingest-cupertino-events.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/kavitha/Projects/acamar/logs/ingest-cupertino-events.error.log</string>

    <!-- Local Postgres must be running; the script waits up to ~2 min for
         the network itself (Wi-Fi right after wake) and starts/stops its
         own cloud-sql-proxy for the cloud write. -->
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
