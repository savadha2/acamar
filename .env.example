# Postgres connection (local dev)
DATABASE_URL=postgresql://localhost:5432/acamar

# Ollama (local LLM)
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=8192
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIM=768
OLLAMA_SUMMARY_MODEL=llama3

# Faria events scraper
FARIA_CALENDAR_URL=https://faria.cusdk8.org/about-us/school-calendar
# Set a real contact URL or email before running the scraper unattended:
SCRAPER_USER_AGENT=ACAMAR/0.1 (personal daily-care dashboard)
SCRAPER_MIN_REQUEST_INTERVAL_SECONDS=5
SCRAPER_MAX_ATTEMPTS=3

# Cupertino Parks & Rec events scraper (shares SCRAPER_* above)
# CUPERTINO_EVENTS_CALENDAR_URL=https://www.cupertino.gov/Parks-Recreation/Events/Parks-and-Recreation-Event-Calendar

# Gmail connector (shared transport; each source below has its own query)
GMAIL_CREDENTIALS_PATH=./secrets/gmail_credentials.json
GMAIL_TOKEN_PATH=./secrets/gmail_token.json

# Menu (parked — see backlog). No default; required only once un-parked:
# GMAIL_MENU_SEARCH_QUERY=from:noreply@schoolnutritionandfitness.com

# School events/reminders (ParentSquare + direct teacher mail). No default:
# GMAIL_SCHOOL_SEARCH_QUERY=label:your-parentsquare-label-here
# Privacy guardrail: skip self-sent mail (comma-separated if more than one):
# HOUSEHOLD_EMAIL_ADDRESSES=you@example.com

# Pilot Cockpit (manual menu upload + observability + kill switch). No
# default — unset means every /admin/* route 401s, not a silent open surface.
# Separate from any subscribers token; generate your own random string.
# COCKPIT_TOKEN=
# The (school, menu) source's id, once seeded via scripts/token.py-style
# setup — pre-fills the cockpit's upload form:
# MANUAL_MENU_SOURCE_ID=
